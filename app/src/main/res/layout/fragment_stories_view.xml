<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.StoriesViewFragment">
<ImageView
    android:id="@+id/status_images"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:contentDescription="@string/image"
    android:scaleType="fitXY"
    android:layout_marginBottom="5dp"
    app:layout_constraintHeight_percent=".7"
   app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"/>

    <jp.shts.android.storiesprogressview.StoriesProgressView
        android:id="@+id/stories_view"
        android:layout_marginTop="7dp"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/back_btn"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/image"
        android:background="@color/black"
        android:src="@drawable/baseline_arrow_back_24"
       app:layout_constraintStart_toStartOf="parent"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toBottomOf="@id/stories_view"/>


    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/roundedImageView"
        android:layout_width="@dimen/_35sdp"
        android:layout_height="@dimen/_35sdp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="5dp"
        android:src="@mipmap/ic_launcher"
        app:layout_constraintStart_toEndOf="@id/back_btn"
        app:layout_constraintTop_toBottomOf="@id/stories_view"
        app:riv_oval="true"
        android:scaleType="centerCrop"/>

    <TextView
        android:id="@+id/tv_update_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="siddharth"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="normal"
        android:layout_margin="10dp"
        app:layout_constraintTop_toTopOf="@id/roundedImageView"
        app:layout_constraintStart_toEndOf="@id/roundedImageView" />
    
    <ImageButton
        android:id="@+id/cancel_btn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="18dp"
        android:contentDescription="@string/image"
        android:src="@drawable/outline_cancel_24"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="10dp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@id/stories_view"/>

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="@dimen/_35sdp"
    android:background="@drawable/et_bcnd"
    android:layout_marginBottom="15dp"
    android:layout_marginStart="7dp"
    android:layout_marginEnd="7dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="parent">
    <EditText
        android:id="@+id/et_send_msg"
        android:layout_width="0dp"
        android:layout_height="@dimen/_35sdp"
        app:layout_constraintWidth_percent=".59"
        android:hint="Reply"
        android:textColorHint="#ffffff"
        android:padding="7dp"
        android:inputType="text"
        android:textSize="@dimen/_12ssp"
        android:background="@drawable/et_bcnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/btn_snd"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:background="@drawable/et_bcnd"
        android:src="@drawable/baseline_arrow_right_24_green"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="15dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>





    <ImageButton
        android:id="@+id/view_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/image"
        android:visibility="gone"
        android:src="@drawable/baseline_remove_red_eye_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias=".94"
        app:layout_constraintHorizontal_bias=".5"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="10dp"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tv_viewed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="19sp"
        android:textStyle="normal"
        android:layout_margin="5dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/view_btn"
        app:layout_constraintStart_toEndOf="@id/view_btn" />


</androidx.constraintlayout.widget.ConstraintLayout>