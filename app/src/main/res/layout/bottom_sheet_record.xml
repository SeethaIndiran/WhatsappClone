<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:padding="10dp"
    android:layout_marginBottom="10dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_one"
        android:layout_width="match_parent"
        android:layout_height="70dp"
       android:layout_margin="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.34"
            android:textSize="@dimen/_13ssp"
            android:textColor="@color/black"
            android:textStyle="normal"
            android:layout_marginTop="5dp"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageButton
            android:id="@+id/play_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
           android:src="@drawable/round_play_arrow_24"
            android:scaleType="center"
            android:visibility="invisible"
            android:background="@drawable/white_round_bgnd"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <SeekBar
            android:id="@+id/seekBars"
            android:layout_width="0dp"
            android:layout_marginTop="5dp"
            app:layout_constraintWidth_percent=".85"
            android:layout_height="30dp"
            android:thumbTint="#128c7e"
            android:progress="0"
            android:progressTint="#128c7e"
            android:visibility="invisible"
            app:layout_constraintStart_toEndOf="@id/play_btn"
            app:layout_constraintTop_toTopOf="@id/play_btn"/>

        <com.example.chattingapp.models.WaveformView
            android:id="@+id/waveform"
            android:layout_width="0dp"
            app:layout_constraintWidth_percent=".85"
            android:layout_height="100dp"
            app:layout_constraintStart_toEndOf="@id/tv_timer"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageButton
        android:id="@+id/delete_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/baseline_delete_24"
        android:scaleType="center"
        android:background="@drawable/white_round_bgnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_one"
        android:contentDescription="@string/image"
        android:layout_marginTop="5dp"
        android:layout_marginStart="15dp"/>

    <ImageButton
        android:id="@+id/record_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/baseline_pause_24"
        android:scaleType="center"
        android:background="@drawable/pause_btn_bgnd"
        app:layout_constraintStart_toEndOf="@id/delete_btn"
        app:layout_constraintTop_toTopOf="@id/delete_btn"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="55dp"
        android:contentDescription="@string/image"
        />

    <ImageButton
        android:id="@+id/send_btn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/baseline_send_24"
        android:background="@drawable/send_btn_bgnd"
        android:scaleType="center"
        android:layout_marginEnd="25dp"
        app:layout_constraintTop_toTopOf="@id/record_btn"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@string/image"
        />


</androidx.constraintlayout.widget.ConstraintLayout>