<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/senderMessageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="7dp"
    android:layout_gravity="end"
    android:padding="8dp"
    android:orientation="vertical"
    >

    <!-- TextView for text messages -->
    <TextView
        android:id="@+id/senderMessageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sender's message"
        android:background="@drawable/item_msg_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="@android:color/black"
        android:padding="8dp" />

    <!-- ImageView for images, video, etc. -->
    <ImageView
        android:id="@+id/senderMessageImage"
        android:layout_width="wrap_content"
        android:layout_height="200dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/audioLayoutSender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="horizontal"
        android:visibility="gone"> <!-- Set visibility to 'gone' by default -->

        <!-- Play/Pause Button -->
        <ImageButton
            android:id="@+id/audioPlayPauseButtonSender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/round_play_arrow_24"
            android:contentDescription="Play Audio"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp" />

        <!-- SeekBar for audio progress -->
        <SeekBar
            android:id="@+id/audioSeekBarSender"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:max="100" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
