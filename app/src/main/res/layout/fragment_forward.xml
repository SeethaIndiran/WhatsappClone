<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.ForwardFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="@color/white"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/back_btn"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/baseline_arrow_back_24"
                android:scaleType="fitXY"
                android:background="@drawable/btn_bgnd_audio"
                app:layout_constraintStart_toStartOf="parent"
                android:contentDescription="@string/image"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/_7sdp"/>

            <TextView
                android:id="@+id/tv_forward_to"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forward_to"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@id/back_btn"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="9dp"/>

            <ImageButton
                android:id="@+id/search_btn"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/ic_baseline_search_24"
                android:scaleType="fitXY"
                android:background="@drawable/btn_bgnd_audio"
               app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/image"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/_7sdp"/>

            <ImageButton
                android:id="@+id/all_chats_btn"
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:src="@drawable/baseline_people_24"
                android:scaleType="fitXY"
                android:background="@drawable/btn_bgnd_audio"
                app:layout_constraintEnd_toStartOf="@id/search_btn"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/image"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/_7sdp"/>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:id="@+id/tv_frequently_contacted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/frequent"
        android:textColor="#808080"
        android:textSize="13sp"
        android:textStyle="normal"
        android:layout_marginStart="10dp"
        android:layout_marginTop="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_frequent"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_frequently_contacted"
       />

    <TextView
        android:id="@+id/tv_recent_chats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/recent"
        android:textColor="#808080"
        android:textSize="13sp"
        android:textStyle="normal"
        android:layout_marginTop="15dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_frequent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_recent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_recent_chats"
        app:layout_constraintBottom_toBottomOf="parent"/>
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_forward"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_forward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kumar"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="normal"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageButton
            android:id="@+id/forward_btn_bottom"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/baseline_arrow_right_24"
            android:contentDescription="@string/image"
            android:scaleType="fitXY"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_bgnd_audio"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>



    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>