<?xml version="1.0" encoding="utf-8"?>
<!--suppress NavigationFile -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/signInFragment"

    tools:ignore="MissingDefaultResource">

    <action android:id="@+id/action_global_messageChatFragment"
        app:destination="@id/messageChatFragment"
        app:launchSingleTop="true"/>


    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.chattingapp.fragments.MainFragment"
        android:label="fragment_main"
        tools:layout="@layout/fragment_main" >
        <action
            android:id="@+id/action_mainFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>
    <fragment
        android:id="@+id/chatsFragment"
        android:name="com.example.chattingapp.fragments.ChatsFragment"
        android:label="fragment_chats"
        tools:layout="@layout/fragment_chats" />
    <fragment
        android:id="@+id/callsFragment"
        android:name="com.example.chattingapp.fragments.CallsFragment"
        android:label="fragment_calls"
        tools:layout="@layout/fragment_calls" />
    <fragment
        android:id="@+id/statusFragment"
        android:name="com.example.chattingapp.fragments.StatusFragment"
        android:label="fragment_status"
        tools:layout="@layout/fragment_status" >

        <action
            android:id="@+id/action_statusFragment_to_myStatusFragment"
            app:destination="@id/myStatusFragment" />
    </fragment>
    <fragment
        android:id="@+id/signInFragment"
        android:name="com.example.chattingapp.fragments.SignInFragment"
        android:label="SignInFragment" >
        <action
            android:id="@+id/action_signInFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_signInFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
    </fragment>
    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.chattingapp.fragments.SignUpFragment"
        android:label="fragment_sign_up"
        tools:layout="@layout/fragment_sign_up" >
        <action
            android:id="@+id/action_signUpFragment_to_signInFragment"
            app:destination="@id/signInFragment" />
        <action
            android:id="@+id/action_signUpFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
    </fragment>
    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.chattingapp.fragments.WelcomeFragment"
        android:label="WelcomeFragment" >
        <action
            android:id="@+id/action_welcomeFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_welcomeFragment_to_signInFragment"
            app:destination="@id/signInFragment" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.chattingapp.fragments.SearchFragment"
        android:label="SearchFragment"
        tools:layout="@layout/fragment_search">
        <action
            android:id="@+id/action_searchFragment_to_messageChatFragment"
            app:destination="@id/messageChatFragment" />
    </fragment>
    <fragment
        android:id="@+id/messageChatFragment"
        android:name="com.example.chattingapp.fragments.MessageChatFragment"
        android:label="fragment_message_chat"
        tools:layout="@layout/fragment_message_chat" >
        <action
            android:id="@+id/action_messageChatFragment_to_imageVideoFragment"
            app:destination="@id/imageVideoFragment" />
    </fragment>

    <argument
        android:name="userIdVisit"
        app:nullable="true"
        android:defaultValue="@null"
        app:argType="string"
       />
    <fragment
        android:id="@+id/imageVideoFragment"
        android:name="com.example.chattingapp.fragments.ImageVideoFragment"
        android:label="fragment_image_video"
        tools:layout="@layout/fragment_image_video" >

        <argument
            android:name="chat"
            app:nullable="true"
            android:defaultValue="@null"
            app:argType="com.example.chattingapp.models.Chat"
            />


    </fragment>
    <fragment
        android:id="@+id/myStatusFragment"
        android:name="com.example.chattingapp.fragments.MyStatusFragment"
        android:label="MyStatusFragment"
        tools:layout="@layout/fragment_my_status">

        <argument
            android:name="status"
            app:nullable="true"
            app:argType="com.example.chattingapp.models.Status"
            android:defaultValue="@null"
            />
        <action
            android:id="@+id/action_myStatusFragment_to_statusFragment"
            app:destination="@id/statusFragment" />


    </fragment>
    <fragment
        android:id="@+id/verifyNumberFragment"
        android:name="com.example.chattingapp.fragments.VerifyNumberFragment"
        android:label="fragment_verify_number"
        tools:layout="@layout/fragment_verify_number" >
        <action
            android:id="@+id/action_verifyNumberFragment_to_OTPFragment"
            app:destination="@id/OTPFragment" />
        <action
            android:id="@+id/action_verifyNumberFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
    </fragment>
    <fragment
        android:id="@+id/OTPFragment"
        android:name="com.example.chattingapp.fragments.OTPFragment"
        android:label="fragment_o_t_p"
        tools:layout="@layout/fragment_o_t_p" />
    <argument
        android:name="number"
        app:nullable="true"
        app:argType="string"
        android:defaultValue="@null"
       />
    <action
        android:id="@+id/action_OTPFragment_to_mainFragment"
        app:destination="@id/mainFragment" />
    <fragment
        android:id="@+id/whatsAppWelcomeFragment"
        android:name="com.example.chattingapp.fragments.WhatsAppWelcomeFragment"
        android:label="fragment_whats_app_welcome"
        tools:layout="@layout/fragment_whats_app_welcome" >
        <action
            android:id="@+id/action_whatsAppWelcomeFragment_to_verifyNumberFragment"
            app:destination="@id/verifyNumberFragment" />
        <action
            android:id="@+id/action_whatsAppWelcomeFragment_to_mainFragment"
            app:destination="@id/mainFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.chattingapp.fragments.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" >
        <action
            android:id="@+id/action_profileFragment_to_mainFragment"
            app:destination="@id/mainFragment" />

    </fragment>
    <fragment
        android:id="@+id/testFragment"
        android:name="com.example.chattingapp.fragments.TestFragment"
        android:label="fragment_test"
        tools:layout="@layout/fragment_test" />


</navigation>